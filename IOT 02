# Student Marksheet

name = input("Enter student name: ")
roll_no = input("Enter roll number: ")

print("\nEnter marks out of 100:")

english = float(input("English: "))
math = float(input("Mathematics: "))
physics = float(input("Physics: "))
programming = float(input("Programming: "))
islamiat = float(input("Islamiyat: "))

total = english + math + physics + programming + islamiat
percentage = total / 5

if percentage >= 80:
    grade = "A+"
elif percentage >= 70:
    grade = "A"
elif percentage >= 60:
    grade = "B"
elif percentage >= 50:
    grade = "C"
elif percentage >= 40:
    grade = "D"
else:
    grade = "F"

# A student fails if any subject is below 40
if (english < 40 or math < 40 or physics < 40 or
        programming < 40 or islamiat < 40):
    result = "Failed"
else:
    result = "Passed"

print("\n========== STUDENT MARKSHEET ==========")
print("Name:", name)
print("Roll No:", roll_no)
print("----------------------------------------")
print("English:", english)
print("Mathematics:", math)
print("Physics:", physics)
print("Programming:", programming)
print("Islamiyat:", islamiat)
print("----------------------------------------")
print("Total Marks:", total, "/ 500")
print("Percentage:", percentage, "%")
print("Grade:", grade)
print("Result:", result)
print("========================================")
